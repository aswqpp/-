{
  "name": "rps-arena",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --port 8787",
    "build": "tsc -b && vite build",
    "preview": "npm run build && wrangler dev --port 8787",
    "deploy": "npm run build && wrangler deploy",
    "test": "node --experimental-strip-types --no-warnings scripts/engine-test.ts",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261124.1",
    "@tailwindcss/vite": "^4.3.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "wrangler": "^4.167.0"
  }
}
